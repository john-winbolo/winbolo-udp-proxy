# ── Main deployment config (proxy behind the shared Caddy on this host) ──
# Copy to .env, fill in the blanks, then: docker compose up -d

# WBN backend that resolves join codes. On the box that RUNS WBN this is its
# internal address (WBN's backend port published on the host):
WBN_API_URL=http://host.docker.internal:8081
# Force plain HTTP only when WBN_API_URL is a BARE host (no scheme). Not needed
# when the URL already starts with http:// or https://.
WBN_API_INSECURE=false

# Origins allowed to open the WebSocket (browser Origin header).
# COMMA-separated for multiple. Empty = allow any origin.
ALLOWED_ORIGIN=https://play.winbolo.com,https://play.winbolo.net

# Restrict which game servers may be proxied (host:port, COMMA-separated).
# Empty = allow any server.
SERVER_ALLOWLIST=

# ── Connection guards ──
MAX_CONNECTIONS=500
RATE_LIMIT_PER_IP=30
RATE_LIMIT_WINDOW=1m
