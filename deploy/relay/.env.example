# ── Regional relay config (self-contained Caddy + proxy) ──
# Copy to .env, fill in the blanks, then: docker compose up -d

# Public hostname(s) Caddy serves and obtains TLS certs for.
# SPACE-separated if you list more than one.
# Each name needs a public DNS A/AAAA record pointing at THIS box.
RELAY_DOMAIN=relay-au.winbolo.net relay-au.winbolo.com

# Central WBN backend that resolves join codes. Join codes are global, so a
# regional relay must point at the PUBLIC central API — not a local one.
WBN_API_URL=https://wbn.winbolo.net

# IP(s) allowed to reach /health and /metrics through Caddy.
# SPACE-separated for multiple (Caddy remote_ip matcher), e.g. "1.2.3.4 10.0.0.0/8".
# Fill this in — an EMPTY value makes the Caddy config fail to load.
METRICS_ALLOW_IP=

# Origins allowed to open the WebSocket (browser Origin header).
# COMMA-separated for multiple. Empty = allow any origin.
ALLOWED_ORIGIN=https://play.winbolo.com,https://play.winbolo.net

# Restrict which game servers may be proxied (host:port, COMMA-separated).
# Empty = allow any server (usually fine when the relay only fronts your own boxes).
SERVER_ALLOWLIST=

# ── Connection guards ──
MAX_CONNECTIONS=500
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW=1m
